generator client {
  provider = "prisma-client"
  output   = "../apps/web/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String                 @id
  name               String
  roleTag            String
  contactCard        String?
  isSeedCandidate    Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  assessments        AssessmentSubmission[]
  plazaListing       PlazaListing?
  personalityProfile PersonalityProfile?
  matchIntents       MatchIntent[]
  reconnectDecisions ReconnectDecision[]
  secondMeAccount    SecondMeAccount?
  secondMeWritebacks SecondMeWriteback[]
}

model SecondMeAccount {
  id                 String    @id @default(cuid())
  userId             String?   @unique
  secondmeUserId     String    @unique
  name               String?
  email              String?
  avatarUrl          String?
  route              String?
  accessToken        String
  refreshToken       String
  tokenExpiresAt     DateTime
  scopeJson          String
  shadesJson         String?
  softMemoryJson     String?
  profileSignalsJson String?
  profileFetchedAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AssessmentSubmission {
  id                String               @id @default(cuid())
  userId            String
  answersJson       String
  questionCount     Int
  submittedAt       DateTime             @default(now())
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  secondMeWritebacks SecondMeWriteback[]
}

model PersonalityProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  wmtiLetters            String
  wmtiJson               String
  baseWmtiJson           String?
  correctionJson         String?
  secondMeEvidenceJson   String?
  lifeModeTitle          String
  workModeTitle          String
  strengthsJson          String
  risksJson              String
  collaborationStyleJson String
  collaborationThesis    String   @default("")
  bestWith               String   @default("")
  frictionWith           String   @default("")
  preferredWorkSplit     String   @default("")
  badStartPattern        String   @default("")
  likelyMisread          String   @default("")
  suggestedLead          String   @default("")
  cardSummary            String
  cardTagline            String
  actionHintsJson        String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PlazaListing {
  id               String   @id @default(cuid())
  userId           String   @unique
  enabled          Boolean  @default(false)
  headline         String
  lookingFor       String
  focusTagsJson    String
  availabilityNote String
  lastActiveAt     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MatchSignal {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  status     String   @default("pending")
  sessionId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fromUserId, toUserId])
}

model MatchIntent {
  id           String          @id @default(cuid())
  userId       String
  targetUserId String
  lookingFor   String
  mustHaveJson String
  redFlagsJson String
  scene        String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions     SandboxSession[]
}

model SandboxSession {
  id                 String             @id @default(cuid())
  matchIntentId      String
  userId             String
  targetUserId       String
  source             String             @default("demo")
  topicId            String
  topicTitle         String
  topicSourceUrl     String
  topicPrompt        String
  topicRiskTagsJson  String
  fitScore           Int?
  recommendation     String?
  conflictFlagsJson  String?
  currentRound       Int                @default(0)
  state              String             @default("matched")
  finalizedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  matchIntent        MatchIntent        @relation(fields: [matchIntentId], references: [id], onDelete: Cascade)
  rounds             SandboxRound[]
  manual             CollaborationManual?
  reconnectDecisions ReconnectDecision[]
  secondMeWritebacks SecondMeWriteback[]
}

model SandboxRound {
  id             String         @id @default(cuid())
  sessionId      String
  roundIndex     Int
  roundType      String         @default("positioning")
  issue          String?
  question       String
  agentAResponse String
  agentBResponse String
  observerNote   String
  tensionPoint   String?
  concession     String?
  boundary       String?
  synthesis      String?
  roundJson      String?
  fitScore       Int
  createdAt      DateTime       @default(now())
  session        SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, roundIndex])
}

model CollaborationManual {
  id                     String         @id @default(cuid())
  sessionId              String         @unique
  summary                String
  complementsJson        String
  riskPointsJson         String
  communicationRulesJson String
  workSplitSuggestionsJson String
  zhihuAdviceRefsJson    String
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  session                SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ReconnectDecision {
  id        String         @id @default(cuid())
  sessionId String
  userId    String
  confirmed Boolean
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  session   SandboxSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model SecondMeWriteback {
  id           String               @id @default(cuid())
  targetKey    String               @unique
  userId       String
  sessionId    String?
  assessmentId String?
  milestone    String
  previewJson  String
  payloadJson  String?
  consented    Boolean              @default(false)
  status       String               @default("pending")
  errorMessage String?
  writtenAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  assessment   AssessmentSubmission? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  session      SandboxSession?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
}
